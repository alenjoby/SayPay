diff --git a/frontend/src/components/VoiceResultCard.tsx b/frontend/src/components/VoiceResultCard.tsx
new file mode 100644
index 0000000..7093e1a
--- /dev/null
+++ b/frontend/src/components/VoiceResultCard.tsx
@@ -0,0 +1,103 @@
+import React from 'react';
+import type { SupportedLanguage } from '../utils/i18n';
+
+/** What the voice bar shows after a command: heard text, model result, reply. */
+export interface VoiceCard {
+  heard: string;
+  intent: string;
+  confidence?: number;
+  reply: string;
+  status: 'ok' | 'ask' | 'blocked' | 'fallback';
+  lang: SupportedLanguage;
+}
+
+const INTENT_LABEL: Record<string, string> = {
+  check_balance: 'Check balance',
+  send: 'Send money',
+  receive: 'Receive',
+  history: 'History',
+  tx_status: 'Transfer status',
+  add_contact: 'Add contact',
+  recovery_help: 'Recover wallet',
+  cancel: 'Cancel',
+  unknown: 'Not understood',
+  contacts: 'Contacts',
+  guardians: 'Guardians',
+  passkey_sign: 'Fingerprint',
+  confirm: 'Confirm',
+  earphones_connected: 'Earphones',
+  copy_address: 'Copy address',
+  settings: 'Settings',
+  help: 'Help',
+  switch_mode: 'Switch mode',
+};
+
+const STATUS = {
+  ok: { label: 'Understood', dot: 'bg-emerald-400', ring: 'border-emerald-500/40' },
+  ask: { label: 'Needs a detail', dot: 'bg-amber-400', ring: 'border-amber-500/40' },
+  blocked: { label: 'Not allowed', dot: 'bg-red-400', ring: 'border-red-500/40' },
+  fallback: { label: 'Basic parser (model offline)', dot: 'bg-zinc-400', ring: 'border-zinc-600' },
+};
+
+interface Props {
+  card: VoiceCard | null;
+  listening: boolean;
+  transcript: string;
+}
+
+/**
+ * Sits above the floating voice bar. Hidden from screen readers (aria-hidden):
+ * the same reply is already spoken and announced, so it would be read twice.
+ */
+export const VoiceResultCard: React.FC<Props> = ({ card, listening, transcript }) => {
+  if (!listening && !card) return null;
+
+  if (listening) {
+    return (
+      <div
+        aria-hidden="true"
+        className="pointer-events-none max-w-lg w-full mb-3 rounded-2xl bg-zinc-950/95 text-white border border-[#FF5500]/50 shadow-2xl backdrop-blur-xl px-4 py-3"
+      >
+        <div className="flex items-center gap-2 text-[10px] uppercase tracking-wider text-[#FF5500] font-bold">
+          <span className="w-2 h-2 rounded-full bg-[#FF5500] animate-pulse" />
+          Listening…
+        </div>
+        <p dir="auto" className="mt-1 text-sm font-medium min-h-5">
+          {transcript || <span className="text-zinc-500">Say a command</span>}
+        </p>
+      </div>
+    );
+  }
+
+  const c = card!;
+  const s = STATUS[c.status];
+  const pct = c.confidence !== undefined ? Math.round(c.confidence * 100) : null;
+
+  return (
+    <div
+      aria-hidden="true"
+      className={`pointer-events-none max-w-lg w-full mb-3 rounded-2xl bg-zinc-950/95 text-white border ${s.ring} shadow-2xl backdrop-blur-xl px-4 py-3 space-y-2`}
+    >
+      <div>
+        <div className="text-[10px] uppercase tracking-wider text-zinc-400 font-bold">You said</div>
+        <p dir="auto" lang={c.lang} className="text-sm font-medium">“{c.heard}”</p>
+      </div>
+      <div className="flex items-center gap-2 flex-wrap">
+        <span className="inline-flex items-center gap-1.5 rounded-full bg-zinc-800 px-2.5 py-0.5 text-xs font-bold">
+          <span className={`w-2 h-2 rounded-full ${s.dot}`} />
+          {INTENT_LABEL[c.intent] ?? c.intent}
+        </span>
+        {pct !== null && c.status !== 'fallback' && (
+          <span className="text-[11px] text-zinc-400 font-mono">{pct}% sure</span>
+        )}
+        <span className="text-[11px] text-zinc-400">· {s.label}</span>
+      </div>
+      {c.reply && (
+        <div>
+          <div className="text-[10px] uppercase tracking-wider text-zinc-400 font-bold">SayPay says</div>
+          <p dir="auto" lang={c.lang} className="text-sm text-zinc-100">{c.reply}</p>
+        </div>
+      )}
+    </div>
+  );
+};
