# Your domain. No domain? Use your VPS IP with dashes + .sslip.io, e.g. 203-0-113-7.sslip.io
SAYPAY_DOMAIN=203-0-113-7.sslip.io

# Built frontend (React/Vite `npm run build` output). Default: a small test page.
# FRONTEND_DIST=../frontend/dist

# auto = v3 + mmBERT if ml/models/mmbert_int8 (or mmbert_fp32) exists, else v3
SAYPAY_ENGINE=auto
API_MEM_LIMIT=1500m
