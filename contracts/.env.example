# Copy to .env (git-ignored). Never commit .env, never paste keys in chat.

# Sepolia: the MetaMask account holding your faucet test ETH (MetaMask -> account
# details -> show private key). A throwaway test account only.
DEPLOYER_PRIVATE_KEY=0x...

# Optional. Default: https://ethereum-sepolia-rpc.publicnode.com (free, no signup)
SEPOLIA_RPC_URL=

# Optional: publishes the source on Etherscan (free: etherscan.io -> API Keys)
ETHERSCAN_API_KEY=

# Vault settings (defaults shown)
VAULT_THRESHOLD=2
VAULT_TIMER_SECONDS=120   # demo: 2 minutes for inactivity, recovery delay and grace
VAULT_FUNDING_ETH=0.1     # test ETH put into the vault at deploy (Sepolia default)
GAS_TOPUP_ETH=0.02        # gas money for each demo person (Sepolia default)

# DEMO_*_KEY lines are added by `npm run wallets`.
