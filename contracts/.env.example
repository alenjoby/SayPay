# Sepolia deploy. Copy to .env (never commit .env).
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
DEPLOYER_PRIVATE_KEY=0x...            # a throwaway test key with Sepolia ETH from a faucet
ETHERSCAN_API_KEY=                    # optional, for `npx hardhat verify`

# Vault settings. VAULT_OWNER defaults to the deployer.
VAULT_OWNER=
VAULT_GUARDIANS=0xGuardian1,0xGuardian2,0xGuardian3
VAULT_THRESHOLD=2
VAULT_BENEFICIARY=0xBeneficiary
VAULT_TIMER_SECONDS=120               # demo: 2 minutes for inactivity, recovery delay and grace
VAULT_FUNDING_ETH=0                   # ETH to send in at deploy
